# DocForge configuration. Copy to .env and edit, or set these in the service unit.

# Network
DOCFORGE_HOST=0.0.0.0
DOCFORGE_PORT=8080

# Storage. Use an absolute path on a disk that is backed up.
DOCFORGE_DB=/var/lib/docforge/docforge.db

# Where the built web client lives.
DOCFORGE_WEB_ROOT=/opt/docforge/web

# The seed administrator, created only when the user table is empty.
# There is no default password: set one here or no account is created.
DOCFORGE_ADMIN_EMAIL=admin@localhost
DOCFORGE_ADMIN_PASSWORD=

# Set to 1 when the portal is served over HTTPS, so session cookies are
# marked secure. Leave at 0 for a plain HTTP install on a laptop.
DOCFORGE_SECURE_COOKIES=1

# Believe the X-Forwarded-For header. Turn this on ONLY when a reverse proxy you
# control sets it. With nothing in front of the server the header comes from
# whoever is connecting, who could then use a new value for every sign-in
# attempt to escape the rate limit, and write any address into the audit trail.
DOCFORGE_TRUST_PROXY=0

# Limits
DOCFORGE_MAX_UPLOAD_BYTES=52428800
DOCFORGE_SESSION_TTL=43200
DOCFORGE_LOGIN_RATE_LIMIT=10
